---
/** The logo, the page's sections, the other language, and the way to sign up. */
import AppLogo from '@/components/AppLogo.astro'
import LinkButton from '@/components/ui/LinkButton.astro'
import { appLink } from '@/config'
import { LOCALES, LOCALE_NAMES, LOCALE_SHORT, MESSAGES, localePath, type Locale } from '@/i18n/ui'

interface Props {
  locale: Locale
  /** The page's path without the language, so the switcher keeps it. */
  path?: string
}

const { locale, path = '/' } = Astro.props
const t = MESSAGES[locale].nav
const other = LOCALES.find((l) => l !== locale)!
const SECTIONS = [
  { href: '#features', label: t.features },
  { href: '#how', label: t.how },
  { href: '#faq', label: t.faq },
]
---

<header class="sticky top-0 z-30 border-b border-neutral-200/70 bg-white/75 backdrop-blur-lg">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={localePath(locale)} class="rounded-md">
      <AppLogo />
    </a>
    <nav class="hidden items-center gap-1 text-sm md:flex" aria-label={t.menu}>
      {
        SECTIONS.map((s) => (
          <a href={s.href} class="rounded-md px-3 py-1.5 text-neutral-600 transition-colors hover:text-neutral-950">
            {s.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-1 text-sm sm:gap-2">
      <a
        href={localePath(other, path)}
        hreflang={other}
        lang={other}
        title={LOCALE_NAMES[other]}
        aria-label={`${t.language}: ${LOCALE_NAMES[other]}`}
        class="rounded-md px-2 py-1.5 text-xs font-semibold text-neutral-500 transition-colors hover:text-neutral-950"
      >
        {LOCALE_SHORT[other]}
      </a>
      <LinkButton href={appLink('/register')}>{t.getStarted}</LinkButton>
    </div>
  </div>
</header>
