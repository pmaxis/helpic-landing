---
/** A section's eyebrow, title and lead: centred over what follows, or at the start beside it on wide screens. */
interface Props {
  id?: string
  eyebrow: string
  title: string
  lead?: string
  align?: 'center' | 'start'
}

const { id, eyebrow, title, lead, align = 'center' } = Astro.props
---

<div class:list={['reveal mx-auto max-w-2xl text-center', align === 'start' && 'lg:mx-0 lg:text-left']}>
  <p class="text-sm font-semibold text-emerald-600">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-3xl font-bold tracking-tight text-balance text-neutral-950 sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-lg text-pretty text-neutral-600">{lead}</p>}
</div>
