---
/**
 * A section's eyebrow, title and lead: centred over what follows, or at the
 * start beside it on wide screens. The eyebrow is a chip in the section's
 * colour, with its icon.
 */
import Icon from '@/components/ui/Icon.astro'
import type { IconName } from '@/components/ui/icons'
import { TONES, type Tone } from '@/components/ui/tones'

interface Props {
  id?: string
  eyebrow: string
  title: string
  lead?: string
  align?: 'center' | 'start'
  tone?: Tone
  icon?: IconName
}

const { id, eyebrow, title, lead, align = 'center', tone = 'emerald', icon } = Astro.props
---

<div class:list={['reveal mx-auto max-w-2xl text-center', align === 'start' && 'lg:mx-0 lg:text-left']}>
  <p class:list={['inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset', TONES[tone].chip]}>
    {icon ? <Icon name={icon} class="h-3.5 w-3.5" /> : <span class:list={['h-1.5 w-1.5 rounded-full', TONES[tone].dot]} />}
    {eyebrow}
  </p>
  <h2 id={id} class="mt-4 text-3xl font-bold tracking-tight text-balance text-neutral-950 sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-lg text-pretty text-neutral-600">{lead}</p>}
</div>
