---
/**
 * The site's icons: 24×24 strokes in the current colour, the same family as
 * the app's. Decoration: hidden from screen readers.
 */
import { PATHS, type IconName } from './icons'

interface Props {
  name: IconName
  class?: string
  strokeWidth?: number
}

const { name, class: className = 'h-4 w-4', strokeWidth = 2 } = Astro.props
---

{
  name === 'play' ? (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class={className}
      aria-hidden="true"
    >
      {PATHS[name].map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}
